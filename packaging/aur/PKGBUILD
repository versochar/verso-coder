# Maintainer: versochar
pkgname=verso-coder
pkgver=1.0.4
pkgrel=1
pkgdesc="Yerel öncelikli Qt6 kod editörü — çok sağlayıcılı AI, ajan, LSP, Git"
arch=('x86_64')
url="https://github.com/versochar/verso-coder"
license=('MIT')
depends=('qt6-base' 'qt6-svg' 'qt6-websockets' 'qt6-declarative' 'hunspell' 'hicolor-icon-theme')
makedepends=('cmake' 'pkgconf')
optdepends=('clangd: C/C++ dil sunucusu'
            'pyright: Python dil sunucusu'
            'rust-analyzer: Rust dil sunucusu'
            'gopls: Go dil sunucusu'
            'bwrap: ajan salt-okunur kipi')
source=("$pkgname-$pkgver.tar.gz::https://github.com/versochar/verso-coder/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('646ebd58787f5a2e8cb8a4fdd72a0bd8f763eb071b6a54c43dcfe446d3a445dc')

build() {
  cmake -S "$pkgname-$pkgver" -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
build() {
  # Ağaç-içi derleme: test_stage50 kaynak kökü yukarı arar (makepkg düzeni)
  cmake -S "$pkgname-$pkgver" -B "$pkgname-$pkgver/build" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$pkgname-$pkgver/build" -j"$(nproc)"
}

check() {
  cd "$pkgname-$pkgver/build"
  # ui_smoke/stage46 yavaş ve ortama duyarlıdır; hızlı birim paketleri koşar
  QT_QPA_PLATFORM=offscreen ctest --output-on-failure -E 'ui_smoke|stage46'
}

package() {
  DESTDIR="$pkgdir" cmake --install "$pkgname-$pkgver/build"
}
